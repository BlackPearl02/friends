# Copy to .env.development (gitignored). Load via scripts/with-friends-env.mjs.
# For production values see docs/deployment.md.

# ── Database ────────────────────────────────────────────────────────────────
# Local Docker dev (pnpm db:up → port 15433):
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:15433/friends?schema=public"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:15433/friends?schema=public"
# Supabase prod example (Transaction pooler + Direct):
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ── Auth ────────────────────────────────────────────────────────────────────
# Random 32+ byte string. Required to mint Activity JWTs.
JWT_SECRET="change-me-to-a-long-random-secret"

# ── Discord Developer Portal ─────────────────────────────────────────────────
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# Optional. When unset, exchange tries: omitted → https://127.0.0.1 → https://{clientId}.discordsays.com
DISCORD_ACTIVITY_REDIRECT_URI=""

# ── Service URLs ─────────────────────────────────────────────────────────────
# Local dev:
API_PUBLIC_URL="http://localhost:3000"
ACTIVITY_ORIGIN="http://localhost:3003"
# Vercel prod examples:
# API_PUBLIC_URL="https://friends-api.vercel.app"
# ACTIVITY_ORIGIN="https://friends-activity.vercel.app"

# ── Activity (Vite, public) ───────────────────────────────────────────────────
VITE_DISCORD_CLIENT_ID=""
# Empty in Discord iframe (URL mapping /api handles routing).
# Set only for browser mock outside iframe.
VITE_FRIENDS_API_URL=""
